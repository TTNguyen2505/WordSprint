if("$ENV{APPDATA}" STREQUAL "" OR NOT IS_ABSOLUTE "$ENV{APPDATA}")
    message(FATAL_ERROR "APPDATA must contain the current user's absolute application data path.")
endif()

set(database "$ENV{APPDATA}/WordSprint/WordSprint/wordsprint.db")
foreach(suffix IN ITEMS "" "-wal" "-shm" "-journal")
    set(path "${database}${suffix}")
    if(EXISTS "${path}")
        file(REMOVE "${path}")
        if(EXISTS "${path}")
            message(FATAL_ERROR "Could not delete ${path}. Close WordSprint and retry the build.")
        endif()
        message(STATUS "Deleted ${path}")
    endif()
endforeach()
