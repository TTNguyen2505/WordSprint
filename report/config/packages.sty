%%!
% @file packages.sty
% @brief Core package dependencies and global font configuration.
\ProvidesPackage{config/packages}

% Math packages
\usepackage{amsmath}
\usepackage{amssymb}

% Font handling – XeLaTeX only
\usepackage{fontspec}
% Main text font (serif) – Times New Roman
\setmainfont{Times New Roman}
% Sans-serif font – Times New Roman (đảm bảo tiêu đề luôn dùng Times New Roman)
\setsansfont{Times New Roman}
% Monospace font – Consolas (chỉ dùng cho khối code, môi trường listings)
\setmonofont{Consolas}
\renewcommand{\familydefault}{\rmdefault}

% Basic layout packages
\usepackage[fontsize=13pt]{scrextend}
\usepackage[a4paper, left=30mm, right=20mm, top=20mm, bottom=20mm]{geometry}
\usepackage{setspace}\setstretch{1.5}
\usepackage{indentfirst}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{titletoc}
\usepackage{enumitem}
\usepackage{graphicx}
\usepackage{xcolor}
\usepackage{tikz}
\usepackage{booktabs}
\usepackage{tabularx}
\usepackage{array}
\usepackage{caption}
\usepackage{listings}
\usepackage[printonlyused]{acronym}
\usepackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    urlcolor=black,
    bookmarksnumbered=true
}
